# =============================================================================
# Nativx Assistant — exemplu de configurare
# Copiază în `.env` și completează cu valori reale (NU comite .env).
# =============================================================================

# --- Supabase / Postgres -----------------------------------------------------
# Botul se conectează prin asyncpg DIRECT la Postgres, NU prin clientul HTTP.
# Două roluri (NX-50, vezi docs/db_connections.md):
#
# 1) admin_pool — CONTROL PLANE (resolve_channel) + joburi + migrări. Privilegiat.
#    Connection string direct (port 5432) sau pooler (port 6543).
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres
#
# 2) bot_pool — TENANT PATH. Rol de LOGIN `bot_runtime` (fără bypassrls), parolă
#    proprie, conexiune DIRECTĂ (port 5432, NU pooler transaction-mode).
#    Provisioning o dată: BOT_RUNTIME_PASSWORD='...' python scripts/archive/apply_005.py
#    Gol → cade grațios pe SUPABASE_DB_URL + SET ROLE (DOAR dev/test, nu prod).
DATABASE_URL_BOT=postgresql://bot_runtime:[BOT_PASSWORD]@db.xxxx.supabase.co:5432/postgres
#
# NX-04: assert rol+app.business_id la fiecare checkout din bot_pool (fail-fast).
# 'strict' (default) = IsolationError înainte de primul query; 'off' = sare (WARNING la boot).
DB_ISOLATION_ASSERT=strict

# --- Supabase JS client (DOAR pentru scripturile de seed/embed din db/seed) ---
# Folosite de `npm run seed` și `npm run embed` (tsx), nu de botul Python.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SEED_BUSINESS_SLUG=sole-demo
SEED_BUSINESS_NAME=Sole Demo

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=sk-...
MODEL_AGENT=gpt-5.6-luna
# Escaladare la turele complicate (comparație/mixt/mutație). GOL = totul pe MODEL_AGENT.
# Se aprinde cu un nume de model; alegerea clasei e deterministă (obligațiile turului).
MODEL_AGENT_COMPLEX=
MODEL_TRIAGE=gpt-5.4-nano
MODEL_EMBED=text-embedding-3-small
SEARCH_SHADOW_ENABLED=false       # NX-207: citește search_document_v1; OFF = fallback embeddings 'product'
MODEL_MODERATION=omni-moderation-latest
# Override tarife pt observabilitatea de cost (NX-103). JSON parțial, merge peste implicitul din
# src/agent/pricing.py — tunabil în prod fără redeploy. Gol → tarifele documentate din cod.
# LLM_PRICING_JSON={"gpt-5.6-terra":{"input":2.50,"cached_input":0.25,"output":15.00}}
LLM_PRICING_JSON=

# --- Moderation gate (NX-15) -------------------------------------------------
MODERATION_ENABLED=true           # poartă în gates: mesaj flagged → răspuns neutru (gratuit)
MODERATION_BLOCK_THRESHOLD=3      # flag-uri în 24h → abuse blocklist (contacts.is_blocked)

# --- Media routing: Vision poză→catalog (NX-76, stagiul 3) -------------------
VISION_ENABLED=true               # poză (content_type=image) → descriere Vision ca text de căutare
MODEL_VISION=gpt-5.6-terra        # modelul cu vedere; default = model agent
VISION_MAX_BYTES=5000000          # cap mărime poză descărcată; peste = fail-soft (clarificare)
COST_VISION_USD=0.003             # estimare cost/apel Vision pt contorul zilnic G2c

# --- Meta WhatsApp Cloud API -------------------------------------------------
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=

# --- Redis -------------------------------------------------------------------
# Parolă OBLIGATORIE (NX-02): Redis e backbone-ul cu mesaje de client în zbor.
# Generează 32+ chars: `openssl rand -base64 32`. URL-ul include parola.
REDIS_PASSWORD=schimba-ma-parola-redis-32-chars-minim
REDIS_URL=redis://:schimba-ma-parola-redis-32-chars-minim@redis:6379/0

# --- Telegram (canal de TEST — long polling, fără webhook/HTTPS) -------------
# Token de la BotFather (/newbot). Gol = pollerul Telegram nu pornește.
TELEGRAM_BOT_TOKEN=

# --- Web Widget (NX-20, E26 — al treilea canal, V1.5) ------------------------
WEB_ENABLED=false                # gateway web (POST /web/messages SSE + POST /web/chat sincron); OFF până la V1.5
WEB_SESSION_SECRET_TTL_S=60      # TTL cache public_token→(business_id, session_secret)
WEB_RATE_LIMIT_MAX_VISITOR=15    # max mesaje/fereastră per visitor_id (web public anonim)
WEB_RATE_LIMIT_MAX_IP=40         # max mesaje/fereastră per (token, IP) — prinde rotirea de visitor
WEB_RATE_LIMIT_WINDOW_S=60       # fereastra rate limit web (secunde)
WEB_SSE_HEARTBEAT_S=15           # heartbeat „: keepalive" pe SSE (ține proxy-ul deschis)
WEB_BACKLOG_SIZE=20              # mesaje păstrate per vizitator pt reconectare (Last-Event-ID)
WEB_BACKLOG_TTL_S=300            # TTL backlog SSE (secunde)
WEB_CORS_ORIGINS=                # CSV origin-uri permise pt POST /web/chat (ex. https://shop.ro,http://localhost:5173); gol → doar same-origin

# --- NX-229: marginea web (sesiune v2, poartă demo, limită bootstrap) ---------------------
# Sesiune v2 = claims semnate cu expirare + key id + rotație dual-key. Sesiunea v1 NU expira
# niciodată și nu se putea roti. Verificarea acceptă mereu ambele versiuni în overlap; flagul de
# mai jos controlează doar ce EMITE bootstrap-ul, ca un rollback să nu invalideze sesiuni v2.
WEB_SESSION_V2_ENABLED=false
# Cutover: refuză semnăturile v1. Se aprinde DUPĂ ce toate sesiunile v1 au expirat natural
# (adică după cel puțin WEB_SESSION_TTL_S de la activarea v2).
WEB_SESSION_V2_REQUIRED=false
WEB_SESSION_TTL_S=43200          # 12h
# Leagă sesiunea de originul care a cerut-o. Aprinde DUPĂ ce allowlistul e confirmat în producție.
WEB_SESSION_ORIGIN_BINDING=false
# Rotația cheii de sesiune e o schimbare de DATE, nu de config: pune noul secret în
# `channels.settings.session_secret` și mută-l pe cel vechi în `session_secret_prev`. Ambele
# verifică în overlap; `key_id` se derivă din secret, deci nu există un al treilea câmp de ținut
# sincronizat. Tot acolo poate sta `allowed_origins` (CSV) — allowlist PER CANAL, mai strâns
# decât WEB_CORS_ORIGINS.
#
# Poarta de acces la site-ul demo (`Authorization: Bearer <jwt>`). NU e identitate de cumpărător:
# verificarea întoarce doar trecut/respins, niciodată un `sub`. Identitatea shopperului rămâne
# `id_token` în body (WEB_IDENTITY_ENABLED). Doar HS256; un proiect pe chei asimetrice cade pe
# `bad_alg` (fail-closed, vizibil). Când e OFF, `Authorization` nici nu intră în allowlistul CORS.
WEB_DEMO_ACCESS_ENABLED=false
WEB_DEMO_ACCESS_SECRET=
WEB_DEMO_ACCESS_ISSUER=          # opțional; verificat doar dacă e setat
WEB_DEMO_ACCESS_AUDIENCE=        # opțional; verificat doar dacă e setat
WEB_DEMO_ACCESS_LEEWAY_S=30
# Emiterea de sesiuni era NELIMITATĂ: se puteau coase oricâte visitor_id-uri proaspete ca să se
# ocolească limita per-visitor de pe /web/chat. Cheie pe tenant+IP hash-uit (fără PII).
WEB_BOOTSTRAP_RATE_LIMIT_MAX=10
# NX-120 (DoS hardening): cap de body pe ingestie + cost-cap zilnic per vizitator web.
WEB_MAX_BODY_BYTES=16384         # cap body /web/* (text capat la 2000 char → 16KB acoperă JSON-ul)
WEBHOOK_MAX_BODY_BYTES=262144    # cap body webhook Meta/orders (payload-uri mici → 256KB generos)
WEB_COST_CAP_PER_VISITOR_USD=0.50 # plafon zilnic de cost LLM per vizitator web (token furat ≠ buget golit)
# NX-221: serializare ture per conversație pe /web/chat (rafale = tururi serializate, nu concurente).
WEB_TURN_LOCK_ENABLED=true       # default ON (fix de corectitudine); OFF = comportamentul vechi, byte-identic
TURN_LOCK_TTL_MS=15000           # TTL lock (plasă anti-deadlock dacă procesul moare cu lock-ul luat)
TURN_LOCK_WAIT_MAX_MS=10000      # cât așteaptă un tur lock-ul; expirat → bypass cu event (niciodată tăcere)
# NX-232: ledgerul durabil al turelor web (idempotency + replay exact; cutover pe demo prin flag).
WEB_TURN_LEDGER_ENABLED=false    # OFF = calea veche byte-identică; ON cere migrarea 040 aplicată
WEB_TURN_LEASE_TTL_S=300         # lease claim; ALINIAT cu CLAIM_TTL_S al inbound_dedupe (300s)
WEB_TURN_FINGERPRINT_SECRET=     # cheia HMAC a fingerprint-ului de request (setează în producție)
WEB_TURNS_RETENTION_HOURS=168    # retenție terminale (fereastra de replay)
WEB_TURNS_STALE_DAYS=7           # retenție ne-terminale abandonate (accept fără follow-through)
# NX-256: captura FULL a turului pt diagnoză/test (conversation_traces): client verbatim (forma
# safe) + Reply complet + recomandări + intermediarele (rich JSON brut, id-uri picate la
# membership). OFF = zero rânduri; ON cere migrarea 045 aplicată. Scrisă din aftercare, best-effort.
CONVERSATION_TRACE_ENABLED=false
CONVERSATION_TRACE_RETENTION_DAYS=30  # purjat zilnic (job admin, bounded), NEcondiționat de flag
# NX-233: executorul web asincron (accept 202 → executor cu lease/fencing → GET/SSE replay).
# Flags separate pt rollout gradat; toate OFF = zero schimbare. V1 rămâne neatins până la NX-249.
WEB_TURN_V2_ENABLED=false        # rutele POST/GET /web/v2/turns (cer migrarea 040)
WEB_TURN_EXECUTOR_ENABLED=false  # executorul din procesul worker (claim + pipeline + commit)
WEB_TURN_RECOVERY_ENABLED=false  # sweeperul de recovery (re-wake + terminalizare bounded)
WEB_TURN_SSE_ENABLED=false       # GET /web/v2/turns/{id}/events (SSE; polling rămâne fallback)
WEB_TURN_DEADLINE_S=120          # bugetul TOTAL al turului, fixat la accept; NU crește la reclaim
WEB_TURN_HEARTBEAT_S=60          # renew lease; trebuie să încapă de 2 ori în WEB_TURN_LEASE_TTL_S
WEB_TURN_MAX_ATTEMPTS=3          # peste atâtea claim-uri → terminal onest attempts_exhausted
WEB_TURN_SWEEP_INTERVAL_S=30     # cadența sweeperului (advisory lock: unul mătură per flotă)
WEB_TURN_CLAIM_BATCH=8           # câte ture ia executorul dintr-un scan
WEB_TURN_EXECUTOR_POLL_S=2      # somn între scanuri fără wake (BRPOP timeout)
WEB_TURN_POLL_AFTER_MS=1000      # hint-ul server-owned de polling pt client (202)
WEB_TURN_SSE_POLL_MS=1000        # cadența pollului intern SSE (checkout scurt per poll)
WEB_TURN_SSE_MAX_S=600           # durata maximă a unei sesiuni SSE (reconectare cu Last-Event-ID)
WEB_TURN_SHUTDOWN_GRACE_S=10     # cât așteaptă shutdown-ul turul curent înainte de cancel

# NX-234: contextul de pagină ID-only (browserul trimite identificatori, serverul rehidratează).
# Poarta e AND: prompt exposure fără validare = eroare de boot, nu o configurație „mai permisivă".
WEB_CONTEXT_ENABLED=false              # validare + rehidratare + evenimente (shadow: nu atinge promptul)
WEB_CONTEXT_PROMPT_ENABLED=false       # abia el lasă faptele rehidratate în prompt + ancora deterministă
WEB_CONTEXT_HYDRATION_TIMEOUT_MS=1500  # deadline bounded; peste el contextul e `unavailable`, nu așteptare
WEB_CONTEXT_FRESHNESS_SLA_S=86400      # peste ce vechime un fapt e marcat `stale` (marcat, NU aruncat)
WEB_CONTEXT_PIPELINE_VERSION=web-chat.v1  # contractul scris în snapshot (legat de web_turns.pipeline_version)

# NX-235: ConversationStateV2 — nevoi cu tărie/sursă/status, revocări cu tombstone, clarificare
# cu information gain. Rollout în trepte; poarta e AND (write fără enabled = eroare de boot).
# Fără migrare SQL: upgrade-ul e LAZY, la primul commit al conversației (docs/CONVERSATION-STATE-V2.md).
CONVERSATION_STATE_V2_ENABLED=false        # SHADOW: hidratează + reduce + diff; v1 rămâne autoritatea
CONVERSATION_STATE_V2_WRITE_ENABLED=false  # abia el face v2 formatul PERSISTAT (cititorii v1 → proiecție)
CLARIFICATION_POLICY_V2_ENABLED=false      # întreabă doar cu information gain; anti-buclă pe cheie
REFERENCE_PRECEDENCE_V2_ENABLED=false      # action>named>ordinal>page(deictic)>selected>single
CLARIFICATION_MIN_INFORMATION_GAIN=0.30    # sub prag → răspuns grounded + ce nu știm, nu o întrebare
CONVERSATION_SENSITIVE_MEMORY_ENABLED=false  # fapte sensibile în memorie DOAR cu politică/consimțământ

# NX-236: acțiuni opace semnate (butoanele v2 poartă token sigilat, semantica stă pe server).
# UN kill-switch. ON cere WEB_TURN_V2_ENABLED + un inel de chei valid (altfel procesul nu pornește).
# Generarea unei chei: python -c "import base64,os;print('k1:'+base64.b64encode(os.urandom(32)).decode())"
WEB_ACTIONS_ENABLED=false        # OFF = zero acțiuni emise + input.type=action refuzat onest (422)
WEB_ACTION_KEYS=                 # `kid:base64master[,kid_vechi:base64master]` — prima EMITE, toate VERIFICĂ
WEB_ACTION_TTL_S=1800            # cât trăiește un buton (ancorat în completed_at-ul turului sursă)
WEB_ACTION_CLOCK_SKEW_S=60       # toleranța de ceas între emitent și verificator

# NX-237: coșul canonic al conversației (CartService + mutation receipts idempotente).
# Cere migrarea 041 aplicată. OFF = byte-identic (coșul legacy în conversations.state.cart).
# ON = cart_add/checkout_link + acțiunile de comerț trec prin serviciu: rehidratare + revalidare
# la fiecare mutație, receipt per (tur/acțiune), versiune monotonă; starea ține doar cart_ref.
CONVERSATION_CART_ENABLED=false
COMMERCE_FACTS_SLA_S=86400       # peste prag, snapshotul se declară stale (disclosure, nu blocaj)

# --- NX-238: promovarea candidatului `search_entities` (verdict curent: NOT-READY) -----------
# OFF singur NU e ce ține poarta închisă — candidatul cere ȘI un artefact de decizie cu verdict
# GO, amprentă validă și semnătură verificabilă (reports/nx238/decision.json). Vezi
# docs/NX-238-DECISION.md pentru verdictul măsurat și ce ar trebui să se schimbe ca să fie GO.
RETRIEVAL_CANDIDATE_ENABLED=false
RETRIEVAL_CANDIDATE_ROLLOUT_PCT=0   # bucket STABIL pe (business, conversație); 0 = dark
RETRIEVAL_DECISION_PATH=reports/nx238/decision.json
RETRIEVAL_DECISION_KEY=             # SECRET de operare; gol → un GO nu poate fi verificat
RETRIEVAL_PIPELINE_VERSION=retrieval.v1
RETRIEVAL_DEADLINE_MS=0             # 0 = fără buget de timp pe retrieval (strâns oricum de NX-241)

# --- NX-241: deadline TOTAL de tur + bugete de execuție ----------------------
# Rollout în trepte, în ordinea asta: (1) MĂSOARĂ, (2) impune TIMPUL, (3) impune APELURILE,
# (4) paralelizează citirile. Poarta de boot refuză combinațiile imposibile (3/4 fără 2).
# Detalii + runbook: docs/NX-241-TURN-DEADLINE.md · probă: python scripts/sim/web_latency_probe.py
TURN_LATENCY_SPANS_ENABLED=true   # observe-only: UN event `turn_latency` per tur (faze + bugete)
TURN_DEADLINE_ENABLED=false       # UN deadline monoton propagat tuturor operațiilor (LLM/tool/retrieval)
TURN_BUDGET_ENFORCED=false        # plafoanele de apeluri REFUZĂ (OFF = doar numără); cere TURN_DEADLINE_ENABLED
TURN_PARALLEL_READS_ENABLED=false # citiri independente în paralel (doar pe conn-per-op real); cere deadline
TURN_HARD_DEADLINE_MS=15000       # plafonul DUR de execuție, indiferent ce spune deadline_at
TURN_BUDGET_EXACT_MS=3000         # SLO Stage 1: fapt exact / fast path read-only
TURN_BUDGET_RECOMMENDATION_MS=6000 # recomandare normală (un search + plan)
TURN_BUDGET_COMPLEX_MS=10000      # comparație / mixt
TURN_BUDGET_MUTATION_MS=8000      # coș / checkout / abonare (scrieri seriale)
LLM_CALL_CAP_MS=8000              # plafonul UNUI apel de model; efectiv = min(cap, rămas − rezervă)
LLM_RETRY_MIN_BUDGET_MS=600       # sub atât nu mai pornim un retry (l-am anula oricum)
AFTERCARE_DEADLINE_MS=20000       # aftercare-ul e post-terminal, dar tot bounded; 0 = fără plafon

# --- NX-246: observabilitate (traces + metrici) + markeri de release ---------
# Trei kill-switch-uri INDEPENDENTE, deliberat: în incident vrei „taie exportul, păstrează
# măsurarea locală", nu un buton care le stinge pe toate (ai pierde datele care explică incidentul).
# OBSERVABILITY_ENABLED=false (default) = absorbant: zero span, zero contor, calea fierbinte
# byte-identică. Detalii + runbook: docs/WEB-OBSERVABILITY-SLO.md
OBSERVABILITY_ENABLED=false        # master switch (stins = nu se acumulează NIMIC în memorie)
OBSERVABILITY_TRACES_ENABLED=true  # kill-switch traces (efectiv doar cu master ON)
OBSERVABILITY_METRICS_ENABLED=true # kill-switch metrici (efectiv doar cu master ON)
OBSERVABILITY_EXPORTER=            # gol/none = nimic nu iese din proces · capture = memorie (drive/teste) · otlp = rețea
OBSERVABILITY_OTLP_ENDPOINT=       # http(s)://collector:4318/v1/traces — setat fără master ON ⇒ boot REFUZAT
OBSERVABILITY_OTLP_HEADERS=        # cheie=valoare,cheie2=valoare2 (token de colector — secret)
OBSERVABILITY_OTLP_TIMEOUT_MS=2000
OBSERVABILITY_SAMPLE_RATIO=0.05    # fracțiune din turele de SUCCES; erorile ies ÎNTOTDEAUNA (sampling pe coadă)
OBSERVABILITY_QUEUE_MAX=2048       # coadă MĂRGINITĂ; plină ⇒ drop numărat, niciodată backpressure pe tur
OBSERVABILITY_EXPORT_BATCH=256
OBSERVABILITY_FLUSH_TIMEOUT_MS=2000 # plafonul flush-ului de shutdown (telemetria nu ține procesul)
OBSERVABILITY_TRACE_SECRET=        # HMAC din care se derivă trace-id-ul din turn_id; gol = derivabil public
# --- NX-246 felia 2: feedback one-tap -----------------------------------------
# OFF = niciun prompt emis ⇒ niciun token ⇒ endpointul n-are ce autoriza (poartă DUBLĂ, ca la
# comerțul NX-237). Cere WEB_TURN_V2_ENABLED + WEB_ACTIONS_ENABLED (validat la boot): promptul E
# o acțiune opacă semnată. Detalii: docs/WEB-FEEDBACK.md · raport: scripts/feedback_report.py
WEB_FEEDBACK_ENABLED=false         # emite 👍/👎 pe turele COMPLETATE + deschide /web/v2/feedback
WEB_FEEDBACK_PROMPT_SECRET=        # HMAC din care se derivă feedback_prompt_id; gol = ghicibil din turn_id

SERVICE_NAME=nativx-assistant
RELEASE_SHA=                       # SHA-ul imaginii deployate (marker pe fiecare span + în raportul SLO)
# Trackul PROCESULUI (ce build rulează instanța), NU al unui turn: de la NX-249, trackul unui turn
# e capturat pe rândul lui de ledger, fiindcă un proces poate servi ambele cohorturi.
RELEASE_TRACK=champion             # champion | candidate | canary | unknown

# --- NX-249: controllerul de release (canary + cutover) ------------------------
# OFF (default) = byte-identic: niciun policy citit, nicio captură scrisă. Aprins, fiecare accept
# v2 primește o asignare SERVER-OWNED, capturată durabil ÎNAINTE de orice claim.
# Runbook: docs/STAGE1-CANARY-RUNBOOK.md · CLI: scripts/release_control.py
RELEASE_CONTROLLER_ENABLED=false
RELEASE_ENVIRONMENT=               # gol → ENV. Explicit, fiindcă un policy de staging aplicat în
                                   # prod ar promova trafic real pe o aprobare dată pentru altceva
# Saltul de bucketing. NU intră niciodată în policy, în DB sau în loguri (policy-ul poartă doar
# `stable_salt_id`). OBLIGATORIU în prod: fără el, bucketul de canary e calculabil de oricine
# cunoaște conversation_id, deci un client își poate căuta o conversație care intră în canary.
RELEASE_ASSIGNMENT_SALT=
# TTL-ul cache-ului de policy = fereastra maximă dintre „am apăsat kill-switch" și „ultimul proces
# a aflat". Plafon dur 300s, validat la boot (ținta din runbook e ≤5 minute).
RELEASE_POLICY_REFRESH_S=15

# --- NX-248: operare (health, deploy, credential de migrare) -------------------
# Identitatea artefactului. Le pune DEPLOYUL din manifest, nu omul: un container nu-și poate citi
# propriul digest (vezi src/ops/build_info.py), deci adevărul se stabilește din afară cu
# `docker inspect` + scripts/release/verify_manifest.py.
IMAGE_DIGEST=                      # sha256:… — orice altceva (ex. un TAG) e ignorat, devine `unknown`
BUILT_AT=                          # ISO-8601 UTC din build; invalid ⇒ `unknown`, NU ora pornirii
# Vederea de operator pe /health/detail (sonde + reason codes). GOL = endpointul răspunde 404, nu
# 401: un 401 confirmă că ruta există. Nu trece prin Traefik — vezi docs/PRODUCTION-READINESS.md.
OPS_HEALTH_TOKEN=
OPS_HEARTBEAT_MAX_AGE_S=90         # fereastra de prospețime a heartbeat-ului worker/scheduler
# Credentialul cu drept de DDL. Există DOAR în jobul de migrare (`docker compose --profile migrate
# run --rm migrate`), niciodată în env_file-ul serviciilor de runtime: un proces care nu-l are nu
# poate face DDL nici din greșeală, nici dacă e compromis. `--check` are nevoie doar de SELECT.
DATABASE_URL_MIGRATION=
# Livrare de secrete prin FIȘIER (recomandat pe VPS): orice variabilă de mai sus acceptă un
# `<NUME>_FILE=/run/secrets/<fișier>`. Setarea AMBELOR forme oprește procesul (ambiguitate =
# eroare, nu preferință). Ex.: OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# --- App ---------------------------------------------------------------------
ENV=dev                          # dev | staging | prod
LOG_LEVEL=INFO
DAILY_COST_CAP_USD=5             # cost guard zilnic per business
OPERATOR_ALERT_WEBHOOK=          # optional — URL notificare operator la handoff
HANDOFF_WINDOW_MINUTES=45        # G5a: cât tace botul după handoff (risc/preluare)
HANDOFF_ENABLED_CHANNELS=whatsapp,telegram  # canale cu handoff la om; web (webchat) EXCLUS (fără operator → botul asistă singur)

# --- Mesaj de întâmpinare (free layer, stagiul 4) ----------------------------
WELCOME_ENABLED=true             # pur salut → mesaj de welcome branded, determinist (fără LLM)
WELCOME_BOT_NAME=Native          # numele asistentului; override per business în settings["welcome"]

# --- Strat gratuit alias (NX-73, stagiul 4) ----------------------------------
ALIAS_ENABLED=true               # match exact `intent_aliases` aprobate, înainte de cache; zero LLM

# --- Cache semantic (G5b) ----------------------------------------------------
CACHE_ENABLED=true               # stratul gratuit 4: servește răspunsuri repetate fără LLM
CACHE_TAU_HIGH=0.92              # prag auto-accept L2 semantic (cosine); conservator
CACHE_TTL_STATIC_DAYS=7         # TTL entry-uri static (FAQ/generic)
CACHE_TTL_DYNAMIC_MINUTES=30    # TTL backstop dynamic (produs); invalidarea reală = price-check

# --- Strat gratuit FAQ (NX-74, stagiul 4) ------------------------------------
FAQ_ENABLED=true                 # întrebări de cunoștințe → răspuns din `faqs` fără LLM de generare
FAQ_TAU_HIGH=0.82                # prag auto-accept strat gratuit (cosine); precision-first
FAQ_TAU_TOOL=0.75               # prag tool faq_lookup (agentul parafrazează → mai relaxat)

VALIDATOR_CLAIMS_ENABLED=true    # NX-117: calea de proză respinge claim-uri ne-numerice (superlativ); fail-open
VALIDATOR_STOCK_CLAIMS_ENABLED=false  # NX-118: „pe stoc" availability-aware; OFF (depinde de calitatea datelor)
SAFETY_MEDICAL_GUARDRAIL_ENABLED=true  # P0-safety: blochează sfat medical (tratează/sarcină/alergeni); răspundere juridică
ANSWER_PLAN_ENABLED=false        # NX-211: activate only after the NX-210 GO
ANSWER_PLAN_CRITIC_ENABLED=false # NX-211: OFF keeps the pre-NX-211 renderer
ANSWER_PLAN_CRITIC_COVERAGE_THRESHOLD=0.99
ANSWER_PLAN_MAX_QUALITY=false    # ON runs the critic on every AnswerPlan sales response

# --- Guardrails de input la gate (NX-121, stagiul 3) ------------------------
INPUT_PII_MASK_ENABLED=true       # maschează telefon/email/IBAN/card din corpul inbound (P12)
INJECTION_SCREEN_ENABLED=false    # ecran anti-injection (detectare); OFF până e seedat DomainPack

# --- Adaptor OpenAI: reziliență (NX-126) ------------------------------------
LLM_TIMEOUT_S=30.0               # timeout per apel OpenAI (anti-hang, mai ales pe web sincron)
LLM_RETRY_MAX=2                  # retry bounded pe tranzitoriu (429/5xx/timeout); respectă Retry-After
EMBED_TIMEOUT_MS=800             # buget de timp pt embed-ul de query (search_products); depășire → lexical-only. 0 = fără timeout
LLM_SAMPLING_ENABLED=true        # ON = trimite `temperature`; OFF = o omite (kill-switch per-model)
LLM_REASONING_EFFORT_AGENT=high  # GPT-5.6 Terra: none/minimal/low/medium/high/xhigh; gol = omis
LLM_TEMPERATURE_TRIAGE=0.2       # temperatura triajului (clasificare deterministă; doar dacă SAMPLING_ENABLED)
LLM_TEMPERATURE_AGENT=0.7        # temperatura agentului (copy variat, ne-repetitiv; doar dacă SAMPLING_ENABLED)
LLM_MAX_TOKENS_AGENT=800         # plafon output agent → max_completion_tokens (NU max_tokens; nu embed/moderate)
AI_DISCLAIMER_ENABLED=false      # dezvăluire AI (art. 50 AI Act): OFF default (nu pe fiecare mesaj); ON o repune

# --- Cost guard + rate limit (G2c, stagiul 2) --------------------------------
COST_GUARD_ENABLED=true          # peste plafonul zilnic → LLM dezactivat (degradare grațioasă)
COST_TRIAGE_USD=0.0003           # estimare cost/tur triaj (nano); plasă, nu facturare
COST_AGENT_USD=0.003             # estimare cost/apel agent (mini); tool-calling ×(1+nr tools)
CONTACT_DAILY_COST_CAP_USD=0     # NX-125: plafon SOFT per-contact (canale identificate); 0=off (opt-in)
# Buget PER-TUR (CONV-COMMERCE P0): observabilitate, NU taie turul — alertă turn_over_budget.
TURN_BUDGET_ALERTS_ENABLED=true  # emite turn_over_budget când un tur e prea lent/scump
TURN_LATENCY_BUDGET_MS=5000      # prag latență end-to-end/tur (doc: 5-8s vs iZi 2-3s); strânge la optimizare
TURN_COST_BUDGET_USD=0.01        # prag cost LLM/tur (max observat ~0.003; alarmă pe outlieri)
POOL_METRICS_ENABLED=true        # NX-161 F0A: emite pool_metrics/tur (acquire-wait + ocupare bot_pool); OFF → fără eveniment
# NX-161 F0C: frâna EXPLICITĂ de concurență a tururilor (înlocuiește frâna accidentală a poolului).
ADMISSION_ENABLED=true           # semafor global de tururi; OFF → fără frână (comportament vechi)
ADMISSION_MAX_INFLIGHT=24        # câte tururi simultan (setat > pool ca să nu bindeze înainte de conn-per-op)
ADMISSION_MAX_PER_BUSINESS=0     # plafon opțional per-business (fairness minimă); 0 = off
ADMISSION_ACQUIRE_TIMEOUT_MS=2000 # cât aștept un slot înainte de re-queue cu backoff (P6); sub TTL conv_lock 30s
ADMISSION_REQUEUE_DELAY_MS=200   # backoff re-queue admission; FĂRĂ cap de drop (P6, niciodată pierdut tăcut)
ADMISSION_REQUEUE_WARN_EVERY=20  # WARNING zgomotos la fiecare N re-puneri (overload susținut → scalează)
RATE_LIMIT_ENABLED=true          # rate limit per contact (peste debounce R1)
RATE_LIMIT_MAX=20                # max mesaje per fereastră
RATE_LIMIT_WINDOW_SECONDS=60     # fereastra rate limit (secunde)

# --- Comerț / bucla de bani (F2) --------------------------------------------
CHECKOUT_BASE_URL=               # base URL checkout (gol → checkout_link ok=False; ?ref= adăugat în cod)
CHECKOUT_LINK_TTL_DAYS=7         # valabilitatea unui link de checkout (zile)
ORDERS_WEBHOOK_SECRET=           # secret HMAC pt X-Orders-Signature: sha256=<hmac(corp brut)> pe /webhook/orders (gol → 403)

# --- Summarizer conversații lungi (G6-2 felia 2, stagiul 6) -----------------
SUMMARY_ENABLED=true             # kill-switch: generare post-tur + citire în context
SUMMARY_THRESHOLD=20             # nr. mesaje/conversație de la care se sumarizează (>= prag)
SUMMARY_REGEN_DELTA=12           # re-sumarizează doar la >= atâtea mesaje noi peste watermark
SUMMARY_MAX_CHARS=600            # bugetul blocului de rezumat în prompt

# --- Mini-scheduler joburi de mentenanță (NX-83) ----------------------------
EMBED_JOB_ENABLED=true              # embed_products orar incremental (doar dacă OPENAI_API_KEY e setat)
SCHEDULER_ROLLUP_HOUR_UTC=0         # ora UTC la care rulează rollup_usage (facturare/dashboard)
SCHEDULER_DEDUPE_INTERVAL_SECONDS=21600   # purjă inbound_dedupe >48h (la 6h)
SCHEDULER_EMBED_INTERVAL_SECONDS=3600     # embed incremental (orar; content_hash → $0 dacă nimic nou)
LIFECYCLE_JOB_ENABLED=true          # Val3: reclasifică nocturn contacts.lifecycle (era nescris → toți „new")
LIFECYCLE_HOUR_UTC=2                # ora UTC a jobului de lifecycle
DEMAND_ROLLUP_ENABLED=true          # NX-217: rollup nocturn demand_daily (raportul de cerere)
LIFECYCLE_CHURN_DAYS=30            # tăcere > atâtea zile → churn_risk (re-engagement)
PARTITION_JOB_ENABLED=true          # NX-218: creează din timp partițiile lunare (altfel totul cade în DEFAULT)
SCHEDULER_PARTITION_INTERVAL_SECONDS=86400  # zilnic e suficient (asigură luna curentă + următoarea)
PARTITION_MONTHS_AHEAD=1            # câte luni în avans se pregătesc

# --- Extractor profil + lead_score (NX-88, post-tur stagiul 9) ---------------
PROFILE_EXTRACTION_ENABLED=true  # nano post-tur: profil whitelist + lead_score determinist (guardat de cost guard)
LEAD_SCORE_HINT_ENABLED=true     # Val3: la lead_score ridicat, nudge per-tur spre checkout (câmp altfel mort)
LEAD_SCORE_HIGH_THRESHOLD=70     # prag (0..100) peste care injectăm nudge-ul de finalizare

# --- Memorie structurată (conversation_facts) --------------------------------
CONVERSATION_FACTS_ENABLED=true       # NX-148: extrage + injectează facts (OFF → doar history+state)
# NX-160 Memory v2 generic (capture broad → classify safety → canonicalize → inject safe):
MEMORY_V2_ENABLED=true                # master: OFF → comportament vechi (whitelist fail-closed)
MEMORY_OPEN_CAPTURE_ENABLED=true      # captură largă (raw_key liber) vs. doar chei canonice
MEMORY_SAFE_INJECTION_ENABLED=true    # injectează facts sigure în prompt (OFF → persistă, nu injectează)
MEMORY_CANONICALIZE_ENABLED=true      # mapează raw_key → canonical_key (pt search/profile/analytics)

# --- Motor proactiv (NX-70, scheduler separat) ------------------------------
PROACTIVE_ENABLED=true           # AWB / back-in-stock / coș abandonat / follow-up → outbox
PROACTIVE_BATCH_SIZE=20          # joburi revendicate per ciclu, per tenant
PROACTIVE_IDLE_SLEEP_S=5         # somn între cicluri când nu e nimic scadent

# --- Dispatcher outbox (NX-147) --------------------------------------------
DISPATCHER_BATCH_SIZE=10         # rânduri revendicate per tenant/ciclu
DISPATCHER_GLOBAL_CONCURRENCY=16 # trimiteri simultane totale per dispatcher
DISPATCHER_TENANT_CONCURRENCY=4  # trimiteri simultane per tenant
DISPATCHER_IDLE_SLEEP_S=0.5      # polling idle; wake/pubsub rămâne follow-up

# --- Inițiatori proactivi (PL-1): sweeper-e care CREEAZĂ proactive_jobs ------
# Rulează în mini-scheduler (src/jobs/scheduler.py); gardat ȘI de PROACTIVE_ENABLED.
PROACTIVE_INITIATORS_ENABLED=true        # OFF → motorul rămâne, dar fără joburi noi
PROACTIVE_INITIATORS_INTERVAL_S=900      # cât de des scanează sursele (coș/restock)
PROACTIVE_INITIATORS_BATCH=200           # candidați procesați per tenant per ciclu
ABANDONED_CART_AFTER_SECONDS=3600        # reaminteste coșul după 1h de la creare
ABANDONED_CART_MAX_AGE_SECONDS=604800    # ignoră coșuri mai vechi de 7 zile (stale)

# --- Validator cifre bare (NX-91, stagiul 8) --------------------------------
VALIDATOR_BARE_NUMBERS_ENABLED=true  # prinde cifre fără valută negroundate (stoc/rating inventat); fail-open
# --- Typing indicator + spargere reply (NX-90, stagiul 9) -------------------
TYPING_ENABLED=true              # „typing…" instant pe inbound (best-effort, direct prin canal)
REPLY_SPLIT_CHARS=200            # reply peste atâtea caractere → spart în max 2 mesaje

# --- Lock per conversație (NX-85, stagiul 2 — ordonare multi-consumer) -------
CONV_LOCK_ENABLED=true           # serializează tururile aceleiași conversații între replici
CONV_LOCK_TTL_SECONDS=30         # TTL lock (plasă dacă worker-ul moare cu lock-ul luat)
CONV_LOCK_REQUEUE_DELAY_MS=150   # backoff la re-queue când conversația e ocupată
CONV_LOCK_MAX_REQUEUES=10        # cap dur de reîncercări → drop (nu rebuclează la infinit)

# --- Retrieval & ranking de produse (ARCH-2026 P0) --------------------------
SEARCH_BLENDED_RANK_ENABLED=true       # `relevance`: scor blended (RRF + social-proof rating + stoc/reducere/concern); OFF → RRF pur (byte-identic)
RICH_PICK_DETERMINISTIC_ENABLED=true   # carduri ordonate de ranking + „Recomandarea mea" = top-ul clasat (model narează); OFF → ordinea/pick-ul modelului
LEXICAL_RANK_V2_ENABLED=false          # NX-226: rang lexical cu FTS/trgm normalizate în [0,1] pe pool + ponderi 0.6/0.4; OFF → suma brută ts_rank_cd+similarity (byte-identic). Aprindere DUPĂ scripts/lexical_rank_compare.py

# --- Response Quality (NX-159) ---
RESPONSE_TELEMETRY_ENABLED=true    # felia 1: emite response_shape + completeness_gap din runner (formă/PII-free); OFF → fără evenimente
SHORT_ACK_GUARD_ENABLED=true       # felia 2: răspuns nano scurt („Da.") pe context de vânzare → chips de continuare, nu fundătură
NO_RESULT_ALTERNATIVES_ENABLED=true # felia 2: no-result sales primește chips de continuare (popular/alt buget/altă categorie)
CHEAPEST_ALTERNATIVES_ENABLED=true # felia 2: „nimic mai ieftin" primește chips clickabile (schimbă buget/categorie)
RESPONSE_STYLE_ENABLED=true        # felia 3: injectează DomainPack.response_style în system-ul de compunere NON-rich (proză/order); OFF/gol → byte-identic
RELATIONS_FIRST_ENABLED=true       # NX-171b: cross-sell/rutină din product_relations (relații explicite); OFF → heuristica veche same-brand/concern
CONTENT_STATUS_FILTER_ENABLED=true # NX-171c: kill-switch GLOBAL al filtrului published; filtrarea efectivă cere opt-in per-tenant (businesses.settings); OFF → filtru dezactivat peste tot
