      "family": ["planner", "find", "show_more"],
      "source": "NX-333 §1: find cu cuvinte, find fără cuvinte cu subiect, show_more pe sesiune, show_more cu schimbări",
      "turns": [
        {
          "user_input": "Vreau un telefon.",
          "shown": ["el-01", "el-02", "el-03"],
          "expect": {
            "interpretation": {
              "acts": [{"kind": "find", "query": "telefon"}],
              "changes": [
                {"op": "set", "dimension": "category", "relation": "eq", "value": "telefoane", "quote": "telefon"}
