    "history": [
     {
      "id": null,
      "body": "vreau sa-mi fac o rutina de seara, am ten mixt si cativa pori dilatati",
      "author": "contact",
      "payload": {
       "turn_id": "8f15ecf4-3edc-42f5-b68d-3e55ba706020",
       "fragment_index": 0
